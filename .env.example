# Server-only. Never prefix with NEXT_PUBLIC_ — that would inline it into the
# browser bundle. Copy from Supabase → Project Settings → API → service_role.
# Required for asset-version creation (generation and manual authoring); the
# low-level commit functions are revoked from every browser role.
SUPABASE_SERVICE_ROLE_KEY=

# Optional integrations
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CCC_TOKEN_ENCRYPTION_KEY=
